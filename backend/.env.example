# ===== BACKEND ENVIRONMENT VARIABLES =====
# Copy to .env for local development

# Application
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/arogya_setu

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_minimum_32_characters

# ===== IBM CLOUD CREDENTIALS =====
# IBM Watsonx (Granite LLM)
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM Watson Speech to Text
IBM_STT_API_KEY=your_ibm_watson_stt_api_key
IBM_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# IBM Watson Text to Speech
IBM_TTS_API_KEY=your_ibm_watson_tts_api_key
IBM_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com

# IBM Cloud Object Storage
IBM_COS_API_KEY=your_ibm_cos_api_key
IBM_COS_ENDPOINT=s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET=arogya-setu-files
IBM_COS_INSTANCE_ID=your_cos_instance_id

# IBM Cloud Functions (optional)
IBM_CF_URL=https://us-south.functions.cloud.ibm.com
IBM_CF_API_KEY=your_cloud_functions_api_key

# SMS (for notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# WhatsApp (via Twilio)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@arogyasetu.health

# Push Notifications (Firebase)
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id

# Google Maps (server-side)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Encryption
ENCRYPTION_KEY=32_character_encryption_key_here!
